{
  "name": "stepchan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @stepchan/server\" \"npm run dev -w @stepchan/web\"",
    "assets": "node scripts/prepare-assets.mjs",
    "validate-assets": "node scripts/prepare-assets.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run validate-assets && npm run typecheck && npm run build -w @stepchan/web && npm run build -w @stepchan/server",
    "start": "npm run start -w @stepchan/server",
    "postinstall": "npm run assets"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
