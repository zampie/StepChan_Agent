{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Step酱",
  "version": "2.0.0",
  "identifier": "com.stepfun.stepchan.pet",
  "build": {
    "beforeDevCommand": "npm run dev -w @stepchan/web",
    "beforeBuildCommand": "npm run build -w @stepchan/web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost wss://api.stepfun.com https://api.stepfun.com https://models-proxy.stepfun-inc.com; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
