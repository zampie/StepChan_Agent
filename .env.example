# 服务端读取项目根目录 .env。不要使用 VITE_ 前缀。
# 官方地址：https://api.stepfun.com/v1
LLM_PROVIDER=stepfun
STEPFUN_API_KEY=
STEPFUN_MODEL=step-3.7-flash
# Audio 3 TTS + ASR 共用 STEPFUN_API_KEY；服务端音色，可切换为 yuanqishaonv。
STEPFUN_TTS_VOICE=livelybreezy-female
# STEPFUN_MODEL=step-5-preview

# 切回 OpenRouter：注释上方 LLM_PROVIDER，取消下方三项的注释。
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=stepfun/step-5-preview
MAX_TOKENS=1024
REQUEST_TIMEOUT_MS=60000
PORT=3001
